<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane minHeight="0" minWidth="0" prefHeight="832.0" prefWidth="995.0"
            style="-fx-background-color: #f5f0e8;"
            xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="Controller">

    <children>

        <!-- NAV -->
        <HBox prefHeight="45.0" spacing="6.0"
              style="-fx-background-color: #4a7c2f; -fx-padding: 4 10 4 10;"
              AnchorPane.topAnchor="0" AnchorPane.leftAnchor="0" AnchorPane.rightAnchor="0">

            <Button mnemonicParsing="false" onAction="#showHome"
                    prefHeight="36.0" prefWidth="95.0" text="HOME"
                    style="-fx-background-color: #ffffff; -fx-text-fill: #2d5a1b; -fx-border-color: #2d5a1b; -fx-border-width: 1; -fx-border-radius: 4; -fx-background-radius: 4;">
                <font><Font name="Berlin Sans FB" size="14.0"/></font>
            </Button>

            <Button mnemonicParsing="false" onAction="#showShop"
                    prefHeight="36.0" prefWidth="95.0" text="SHOP"
                    style="-fx-background-color: #ffffff; -fx-text-fill: #2d5a1b; -fx-border-color: #2d5a1b; -fx-border-width: 1; -fx-border-radius: 4; -fx-background-radius: 4;">
                <font><Font name="Berlin Sans FB" size="14.0"/></font>
            </Button>

            <Button mnemonicParsing="false" onAction="#showInventory"
                    prefHeight="36.0" prefWidth="125.0" text="INVENTORY"
                    style="-fx-background-color: #ffffff; -fx-text-fill: #2d5a1b; -fx-border-color: #2d5a1b; -fx-border-width: 1; -fx-border-radius: 4; -fx-background-radius: 4;">
                <font><Font name="Berlin Sans FB" size="14.0"/></font>
            </Button>

            <Button mnemonicParsing="false" onAction="#showStatistic"
                    prefHeight="36.0" prefWidth="125.0" text="STATISTIC"
                    style="-fx-background-color: #ffffff; -fx-text-fill: #2d5a1b; -fx-border-color: #2d5a1b; -fx-border-width: 1; -fx-border-radius: 4; -fx-background-radius: 4;">
                <font><Font name="Berlin Sans FB" size="14.0"/></font>
            </Button>

            <Pane HBox.hgrow="ALWAYS"/>

            <Button mnemonicParsing="false" onAction="#saveGame"
                    prefHeight="36.0" prefWidth="90.0" text="SAVE"
                    style="-fx-background-color: #ffffff; -fx-text-fill: #2d5a1b; -fx-border-color: #2d5a1b; -fx-border-width: 1; -fx-border-radius: 4; -fx-background-radius: 4;">
                <font><Font name="Berlin Sans FB" size="14.0"/></font>
            </Button>
        </HBox>

        <!-- INFOS -->
        <HBox alignment="CENTER_LEFT" prefHeight="119.0"
              style="-fx-background-color: #e8f0d8; -fx-border-color: #aaaaaa; -fx-border-width: 0 0 1 0; -fx-padding: 10 15 10 15;"
              AnchorPane.topAnchor="45" AnchorPane.leftAnchor="0" AnchorPane.rightAnchor="0">

            <!-- GAUCHE : Titre -->
            <VBox alignment="CENTER_LEFT" prefWidth="220.0" spacing="8.0">
                <Label text="Farm Simulator"
                       style="-fx-text-fill: #2d5a1b; -fx-font-weight: bold;">
                    <font><Font name="Berlin Sans FB" size="22.0"/></font>
                </Label>
            </VBox>

            <!-- CENTRE : Solde -->
            <HBox alignment="CENTER" spacing="12.0" HBox.hgrow="ALWAYS">
                <Label text="Solde : " style="-fx-text-fill: #333333;">
                    <font><Font name="Berlin Sans FB" size="24.0"/></font>
                </Label>
                <Label fx:id="DollarsView" text="0 $"
                       style="-fx-text-fill: #2d7a00; -fx-font-weight: bold;">
                    <font><Font name="Berlin Sans FB" size="30.0"/></font>
                </Label>
            </HBox>

            <!-- DROITE : Meteo + Alerte + Reset -->
            <VBox alignment="CENTER_LEFT" prefWidth="280.0" spacing="8.0">
                <Label fx:id="MeteoLabel" text="Meteo : "
                       style="-fx-text-fill: #555555;">
                    <font><Font name="Berlin Sans FB" size="12.0"/></font>
                </Label>
                <Label fx:id="AlertLabel" text="" prefWidth="270.0" wrapText="true"
                       style="-fx-text-fill: #cc0000; -fx-font-style: italic;">
                    <font><Font name="Berlin Sans FB" size="12.0"/></font>
                </Label>
                <Button mnemonicParsing="false" onAction="#resetGame"
                        prefHeight="28.0" prefWidth="120.0" text="RESET"
                        style="-fx-background-color: #cc0000; -fx-text-fill: white; -fx-border-radius: 4; -fx-background-radius: 4;">
                    <font><Font name="Berlin Sans FB" size="12.0"/></font>
                </Button>
            </VBox>

        </HBox>

        <!-- HOME -->
        <VBox fx:id="HomePage" style="-fx-background-color: #c8a060;" visible="true"
              AnchorPane.topAnchor="164" AnchorPane.bottomAnchor="0"
              AnchorPane.leftAnchor="0" AnchorPane.rightAnchor="0">
            <GridPane fx:id="farmGrid" hgap="4" vgap="4"
                      style="-fx-background-color: #8B6914; -fx-padding: 4;"
                      VBox.vgrow="ALWAYS"/>
        </VBox>

        <!-- SHOP -->
        <VBox fx:id="ShopPage" alignment="TOP_CENTER" visible="false"
              AnchorPane.topAnchor="164" AnchorPane.bottomAnchor="0"
              AnchorPane.leftAnchor="0" AnchorPane.rightAnchor="0"/>

        <!-- INVENTORY -->
        <VBox fx:id="InventoryPage" visible="false"
              AnchorPane.topAnchor="164" AnchorPane.bottomAnchor="0"
              AnchorPane.leftAnchor="0" AnchorPane.rightAnchor="0"/>

        <!-- STATISTIC -->
        <VBox fx:id="StatisticPage" visible="false"
              AnchorPane.topAnchor="164" AnchorPane.bottomAnchor="0"
              AnchorPane.leftAnchor="0" AnchorPane.rightAnchor="0"/>

    </children>
</AnchorPane>